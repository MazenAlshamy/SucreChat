APP_ENV=development
APP_VERSION=0.1.0
DATABASE_URL=sqlite:///./securechat.db
CORS_ORIGINS=http://localhost:5173
HOST=0.0.0.0
PORT=8000
SESSION_COOKIE_NAME=sc_session
CSRF_COOKIE_NAME=sc_csrf
SESSION_TTL_HOURS=168
ROOM_MAX_PARTICIPANTS_DEFAULT=8
ROOM_MAX_PARTICIPANTS_LIMIT=50
RATE_LIMIT_ENABLED=true
RATE_LIMIT_JOIN_PER_MINUTE=10
RATE_LIMIT_INVITE_LOOKUP_PER_MINUTE=30
RATE_LIMIT_ROOM_CREATE_PER_MINUTE=8
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_PUBLIC_URL=
LIVEKIT_TOKEN_TTL_SECONDS=3600
RATE_LIMIT_LIVEKIT_PER_MINUTE=20
WEBRTC_FALLBACK=true
COOKIE_SECURE=
COOKIE_SAMESITE=lax
PUBLIC_ORIGIN=
FRONTEND_DIST_DIR=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SecureChat
SMTP_USE_TLS=true
SMTP_ENCRYPTION=starttls
EMAIL_VERIFICATION_TTL_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
RATE_LIMIT_REGISTER_PER_MINUTE=8
RATE_LIMIT_VERIFY_PER_MINUTE=10
RATE_LIMIT_RESEND_PER_MINUTE=3
RATE_LIMIT_CHAT_PER_MINUTE=30
CHAT_MESSAGE_MAX_LENGTH=1000
